# Base de Datos (PostgreSQL)
POSTGRES_HOST=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASS=

# Almacenamiento (Cloudflare R2 / S3)
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=

# Autenticación (Auth0)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=

# Inteligencia Artificial (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# RabbitMQ (obligatorio, sin valor por defecto)
RABBITMQ_PASS=

# Qdrant (obligatorio: API key de la instancia)
QDRANT_API_KEY=

# Clave compartida entre el scraper Go y el gRPC interno de la API (obligatoria).
# Genera una aleatoria, por ejemplo: openssl rand -hex 32
INTERNAL_GRPC_KEY=

# Observabilidad (OpenTelemetry). Vacío = no se exporta nada.
# Collector del homelab, accesible solo por el canal seguro (ver docs/observability-architecture.md).
OTEL_EXPORTER_OTLP_ENDPOINT=
# Cabeceras para el Collector, por ejemplo la autenticación: Authorization=Bearer <token>
OTEL_EXPORTER_OTLP_HEADERS=

# Precio del modelo de chat de la plataforma, en EUR por millón de tokens (Ai:Pricing), para el coste
# estimado. Vacío = coste 0 y un aviso en el log; Ollama cuenta siempre como 0. Los modelos que elijan los
# tenants se añaden igual en el environment de apiservice: Ai__Pricing__<proveedor>__<modelo>__Input|Output.
AI_CHAT_PRICE_INPUT_EUR=
AI_CHAT_PRICE_OUTPUT_EUR=
