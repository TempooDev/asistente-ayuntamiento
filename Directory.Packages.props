    <PackageVersion Include="Microsoft.SemanticKernel" Version="1.80.0" />
    <PackageVersion Include="Microsoft.SemanticKernel.Connectors.Google" Version="1.80.0-alpha" />
    <PackageVersion Include="Microsoft.SemanticKernel.Connectors.Ollama" Version="1.80.0-alpha" />
