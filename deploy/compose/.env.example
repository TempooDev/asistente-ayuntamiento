# Environment for deploy/compose/docker-compose.standalone.yml. Copy to deploy/compose/.env and fill in.
# Values marked "required" have no default: `docker compose` stops if they are empty.

# Image tag of the locally built images.
IMAGE_TAG=local
# Port of the web UI and API on the host.
GATEWAY_PUBLISHED_PORT=8080

# local-models = run the chat and embedding models in an Ollama container on this host (no data leaves the server).
# Leave empty to use an external provider (AI_*_PROVIDER below).
COMPOSE_PROFILES=local-models

# Database (PostgreSQL in the compose). POSTGRES_PASS is required.
POSTGRES_DB=asistente
POSTGRES_USER=asistente
POSTGRES_PASS=

# Internal secrets (required). Generate each with: openssl rand -hex 32
RABBITMQ_PASS=
QDRANT_API_KEY=
INTERNAL_GRPC_KEY=

# Object storage. By default the RustFS container of the compose; for R2/S3/MinIO set BLOB_ENDPOINT too.
BLOB_ENDPOINT=
BLOB_BUCKET=asistente-documents
BLOB_ACCESS_KEY=
BLOB_SECRET_KEY=

# Authentication (Auth0, required): one Organization per municipality or public body (tenant).
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=

# Models. Defaults: Ollama on this host (COMPOSE_PROFILES=local-models).
# Providers: ollama, google, openai, openrouter. Changing the embeddings model requires re-ingesting the documents.
AI_CHAT_PROVIDER=ollama
AI_CHAT_MODEL=llama3.2
AI_CHAT_API_KEY=
AI_EMBEDDINGS_PROVIDER=ollama
AI_EMBEDDINGS_MODEL=qwen3-embedding:0.6b
AI_EMBEDDINGS_API_KEY=
AI_EMBEDDINGS_ENDPOINT_URL=
# Ollama elsewhere (for example a GPU server on the private network) instead of the container.
OLLAMA_ENDPOINT=
# Estimated price of the chat model, EUR per 1M tokens (cost tracking). Empty = 0.
AI_CHAT_PRICE_INPUT_EUR=
AI_CHAT_PRICE_OUTPUT_EUR=

# Bulletins downloaded every day.
SCRAPE_SCHEDULED_PROVIDERS=BOE,BOJA

# Days of inactivity after which chat history is deleted (0 = keep it).
CHAT_RETENTION_DAYS=90
# Publish the OpenAPI document at /openapi/v1.json.
OPENAPI_ENABLED=true

# Observability (OpenTelemetry). Empty = nothing is exported.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
