  "components": {
    "schemas": {
      "ArenaCompareRequest": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          }
        }
      },
      "ArenaVoteRequest": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "format": "uuid"
          },
          "winner": {
            "type": "string"
          },
          "clarityReason": {
            "type": [
              "null",
              "string"
            ]
          },
          "precisionReason": {
            "type": [
              "null",
              "string"
            ]
          },
          "optionalComment": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CreateFilterRuleDto": {
        "required": [
          "provider",
          "filterType",
          "value"
        ],
        "type": "object",
        "properties": {
          "provider": {
            "type": "string"
          },
          "filterType": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "ProcessBlobRequest": {
        "type": "object",
        "properties": {
          "blobPath": {
            "type": "string"
          },
          "source": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "QueryRequest": {
        "required": [
          "question"
        ],
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          }
        }
      },
      "QueryResponse": {
        "required": [
          "answer",
          "aiGenerated"
        ],
        "type": "object",
        "properties": {
          "answer": {
            "type": "string"
          },
          "aiGenerated": {
            "type": "boolean"
          }
        }
      },
      "SaveAiConfigurationDto": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "temperature": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?(?:[eE][\u002B-]?\\d\u002B)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "apiKey": {
            "type": [
              "null",
              "string"
            ]
          },
          "endpointUrl": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "TriggerScrapeDto": {
        "required": [
          "provider"
        ],
        "type": "object",
        "properties": {
          "provider": {
            "type": "string"
          },
          "startDate": {
            "type": [
              "null",
              "string"
            ]
          },
          "endDate": {
            "type": [
              "null",
              "string"
            ]
          },
          "sections": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          }
        }
      },
      "UpdateFilterRuleDto": {
        "required": [
          "provider",
          "filterType",
          "value"
        ],
        "type": "object",
        "properties": {
          "provider": {
            "type": "string"
          },
          "filterType": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "UserPreferenceDto": {
        "type": "object",
        "properties": {
          "topics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "locations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "UserProfileDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "auth0UserId": {
            "type": "string"
          },
          "tenantId": {
            "type": "string"
          },
          "fullName": {
            "type": [
              "null",
              "string"
            ]
          },
          "department": {
            "type": [
              "null",
              "string"
            ]
          },
          "position": {
            "type": [
              "null",
              "string"
            ]
          },
          "phoneNumber": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "AsistenteAyuntamiento.ApiService"
    },
    {
      "name": "Query"
    },
    {
      "name": "Ingestion"
    },
    {
      "name": "Arena"
    }
  ]
}
