{
  "folders": [
    { "path": "." }
  ],
  "settings": {
    // Compila con latexmk, que lee .latexmkrc (XeLaTeX + biber + acrónimos).
    "latex-workshop.latex.recipes": [
      { "name": "latexmk (XeLaTeX)", "tools": ["latexmk"] }
    ],
    "latex-workshop.latex.tools": [
      {
        "name": "latexmk",
        "command": "latexmk",
        "args": ["-synctex=1", "-interaction=nonstopmode", "-file-line-error", "%DOC%"]
      }
    ],
    "latex-workshop.latex.recipe.default": "first",
    "latex-workshop.latex.rootFile.useSubFile": false,
    "latex-workshop.latex.autoBuild.run": "onSave",
    "latex-workshop.view.pdf.viewer": "tab",
    "latex-workshop.latex.autoClean.run": "never",
    "files.exclude": {
      "**/*.aux": true, "**/*.bbl": true, "**/*.bcf": true, "**/*.blg": true,
      "**/*.fdb_latexmk": true, "**/*.fls": true, "**/*.ilg": true, "**/*.lof": true,
      "**/*.lot": true, "**/*.nlo": true, "**/*.nls": true, "**/*.out": true,
      "**/*.run.xml": true, "**/*.synctex.gz": true, "**/*.toc": true, "**/*.xdv": true
    },
    "[latex]": {
      "editor.wordWrap": "on"
    }
  },
  "extensions": {
    "recommendations": [
      "james-yu.latex-workshop",
      "ltex-plus.vscode-ltex-plus"
    ]
  }
}
