{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "spa-route": {
        "ClusterId": "webfrontend-cluster",
        "Order": 100,
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "webfrontend-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://webfrontend"
          }
        }
      }
    }
  }
}
