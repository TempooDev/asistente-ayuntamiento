@page "/chat"
@using Microsoft.AspNetCore.Components.Authorization
@using AsistenteAyuntamiento.Web.Client
@using Markdig
@implements IDisposable
@inject ChatSignalRService ChatService
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer

<PageTitle>Chat - AdminAI</PageTitle>

<div class="chat-layout flex h-[calc(100vh-80px)] w-full max-w-[max-width] mx-auto overflow-hidden">
    <!-- Sidebar -->
    <div class="chat-sidebar @(_sidebarOpen ? "open" : "") bg-white border-r border-gray-200 flex flex-col w-[280px] shrink-0 transition-transform duration-300 md:translate-x-0 absolute md:relative z-10 h-full shadow-lg md:shadow-none @(_sidebarOpen ? "translate-x-0" : "-translate-x-full")">
        <div class="chat-sidebar-header p-4 border-b border-gray-100 sticky top-0 bg-white z-20 flex justify-between items-center">
            <button class="gov-btn gov-btn-primary w-full flex items-center justify-center gap-2" @onclick="CreateNewChat">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
                </svg>
                Nuevo Chat
            </button>
            <button class="md:hidden ml-2 text-gray-500" @onclick="ToggleSidebar">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
        <div class="flex-1 overflow-y-auto p-2">
            @if (_sessions.Count == 0)
            {
                <div class="text-center text-sm text-gray-500 py-4">No hay chats recientes</div>
            }
            else
            {
                <div class="space-y-1">
                    @foreach (var session in _sessions)
                    {
                        <div class="chat-session-item p-3 rounded-lg cursor-pointer hover:bg-gray-50 transition-colors @(_currentSessionId == session.Id ? "bg-blue-50 border-l-4 border-blue-600 active" : "")"
                             @onclick="() => SelectSession(session.Id)">
                            <div class="flex justify-between items-center mb-1">
                                <span class="text-xs font-medium text-gray-500">@FormatDate(session.CreatedAt)</span>
                                @if (session.MessageCount > 0)
                                {
                                    <span class="text-[10px] bg-gray-100 text-gray-600 px-2 py-0.5 rounded-full">@session.MessageCount msgs</span>
                                }
                            </div>
                            <p class="text-sm text-gray-800 line-clamp-2 leading-tight">@(string.IsNullOrWhiteSpace(session.Preview) ? "Nueva conversación" : session.Preview)</p>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Main Chat Area -->
    <div class="chat-main flex-1 flex flex-col h-full bg-secondary-bg min-w-0">
        <!-- Mobile Header -->
        <div class="md:hidden bg-white p-3 border-b border-gray-200 flex items-center shrink-0">
            <button class="p-2 text-gray-600 hover:bg-gray-100 rounded-lg" @onclick="ToggleSidebar">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
            </button>
            <h1 class="text-lg font-semibold ml-2 text-primary">Asistente Virtual</h1>
        </div>

        <!-- Chat Header (Desktop) -->
        <div class="hidden md:block px-margin-desktop py-4 shrink-0 bg-white border-b border-gray-200">
            <h1 class="text-heading-1 font-bold text-gray-900 mb-1 text-2xl">Asistente Virtual</h1>
            <p class="text-body-sm text-gray-600">Haz consultas sobre el conocimiento y documentos del ayuntamiento.</p>
        </div>

        <!-- Messages Area -->
        <div class="flex-1 overflow-y-auto p-4 md:p-margin-desktop relative">
            @if (_isLoadingHistory)
            {
                <div class="h-full flex flex-col items-center justify-center text-gray-400 max-w-md mx-auto text-center">
                    <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-primary mb-4"></div>
                    <p class="text-lg font-medium text-gray-600 mb-2">Cargando conversación...</p>
                </div>
            }
            else if (_messages.Count == 0)
            {
                <div class="h-full flex flex-col items-center justify-center text-gray-400 max-w-md mx-auto text-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mb-4 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                    </svg>
                    <p class="text-lg font-medium text-gray-600 mb-2">¿En qué puedo ayudarte hoy?</p>
                    <p class="text-sm">Selecciona una conversación anterior o escribe un mensaje para comenzar una nueva.</p>
                </div>
            }
            else
            {
                <div class="chat-container w-full max-w-3xl mx-auto pb-4">
                    @foreach (var msg in _messages)
                    {
                        <div class="chat-bubble @(msg.IsUser ? "citizen" : "assistant") shadow-sm">
                            @if (msg.IsUser)
                            {
                                <p class="whitespace-pre-wrap">@msg.Text</p>
                            }
                            else
                            {
                                <div class="markdown-content">@RenderMarkdown(msg.Text)</div>
                            }
                        </div>
                    }
                    
                    @if (_isWaitingForResponse)
                    {
                        <div class="chat-bubble assistant flex items-center gap-2 shadow-sm">
                            <span class="w-2 h-2 rounded-full bg-gray-500 animate-bounce" style="animation-delay: 0s;"></span>
                            <span class="w-2 h-2 rounded-full bg-gray-500 animate-bounce" style="animation-delay: 0.2s;"></span>
                            <span class="w-2 h-2 rounded-full bg-gray-500 animate-bounce" style="animation-delay: 0.4s;"></span>
                            <span class="text-sm text-gray-500 ml-1">Procesando...</span>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Input Area -->
        <div class="p-4 md:p-margin-desktop bg-white border-t border-gray-200 shrink-0">
            <div class="max-w-3xl mx-auto flex items-end gap-2">
                <textarea 
                    class="gov-input flex-1 max-h-32 resize-none shadow-sm" 
                    rows="1" 
                    placeholder="Escribe tu consulta aquí..."
                    @bind="_currentMessage"
                    @bind:event="oninput"
                    @onkeydown="HandleKeyDown">
                </textarea>
                
                <button 
                    class="gov-btn gov-btn-primary shadow-sm"
                    style="padding: 12px; min-height: unset; border-radius: 12px; margin-bottom: 2px;"
                    @onclick="SendMessage"
                    disabled="@(string.IsNullOrWhiteSpace(_currentMessage) || !_isConnected)">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                        <path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z" />
                    </svg>
                </button>
            </div>
            
            @if (!_isConnected)
            {
                <div class="text-center mt-2 text-sm text-gray-500 flex items-center justify-center max-w-3xl mx-auto">
                    <span class="w-2 h-2 rounded-full bg-red-500 mr-2 animate-pulse"></span>
                    Conectando al servidor...
                </div>
            }
        </div>
    </div>
    
    <!-- Mobile Backdrop -->
    @if (_sidebarOpen)
    {
        <div class="md:hidden fixed inset-0 bg-black bg-opacity-50 z-[5]" @onclick="ToggleSidebar"></div>
    }
</div>

@code {
    private string _currentMessage = string.Empty;
    private bool _isConnected = false;
    private bool _isWaitingForResponse = false;
    private List<ChatMessage> _messages = new();
    
    private bool _sidebarOpen = false;
    private bool _isLoadingHistory = false;
    private Guid _currentSessionId = Guid.Empty;
    private List<ChatSessionSummaryDto> _sessions = new();
    
    private static readonly MarkdownPipeline _mdPipeline = new MarkdownPipelineBuilder().DisableHtml().UseAutoLinks().Build();
    private static MarkupString RenderMarkdown(string text) => new MarkupString(Markdown.ToHtml(text, _mdPipeline));

    protected override async Task OnInitializedAsync()
    {
        ChatService.OnMessageReceived += HandleIncomingMessage;
        
        try
        {
            await ChatService.ConnectAsync();
            _isConnected = true;
            
            await LoadSessions();
            
            // Auto-load the most recent session on first load if one exists
            if (_sessions.Count > 0)
            {
                await SelectSession(_sessions.First().Id);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error connecting to SignalR: {ex.Message}");
        }
    }

    private async Task LoadSessions()
    {
        if (_isConnected)
        {
            try
            {
                _sessions = await ChatService.GetSessionsAsync();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error loading sessions: {ex.Message}");
            }
        }
    }

    private async Task SelectSession(Guid id)
    {
        _currentSessionId = id;
        _sidebarOpen = false; // close on mobile after selection
        _messages.Clear();
        _isLoadingHistory = true;
        StateHasChanged();

        if (_isConnected)
        {
            try
            {
                var history = await ChatService.LoadSessionAsync(id);
                _messages = history.Select(m => new ChatMessage 
                { 
                    Text = m.Content, 
                    IsUser = m.Role.Equals("User", StringComparison.OrdinalIgnoreCase) 
                }).ToList();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error loading session {id}: {ex.Message}");
            }
            finally
            {
                _isLoadingHistory = false;
                StateHasChanged();
            }
        }
        else 
        {
            _isLoadingHistory = false;
            StateHasChanged();
        }
    }

    private async Task CreateNewChat()
    {
        _sidebarOpen = false; // close on mobile
        _messages.Clear();
        _currentMessage = string.Empty;
        
        if (_isConnected)
        {
            try
            {
                _currentSessionId = await ChatService.CreateNewSessionAsync();
                await LoadSessions();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error creating new session: {ex.Message}");
            }
        }
        else
        {
            _currentSessionId = Guid.NewGuid(); // Fallback if disconnected
        }
        StateHasChanged();
    }

    private void ToggleSidebar()
    {
        _sidebarOpen = !_sidebarOpen;
    }

    private string FormatDate(DateTime date)
    {
        var now = DateTime.Now;
        if (date.Date == now.Date) return "Hoy, " + date.ToString("HH:mm");
        if (date.Date == now.Date.AddDays(-1)) return "Ayer";
        return date.ToString("dd MMM", new System.Globalization.CultureInfo("es-ES"));
    }

    private CancellationTokenSource? _streamingCts;

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(_currentMessage) || !_isConnected || _isWaitingForResponse) return;

        var text = _currentMessage;
        _currentMessage = string.Empty;
        _isWaitingForResponse = true;

        if (_currentSessionId == Guid.Empty)
        {
            await CreateNewChat();
        }

        // Add to UI immediately
        _messages.Add(new ChatMessage { Text = text, IsUser = true });
        
        var assistantMessage = new ChatMessage { Text = "", IsUser = false };
        _messages.Add(assistantMessage);
        
        StateHasChanged();

        // Send to backend via stream
        try
        {
            _streamingCts = new CancellationTokenSource();
            var stream = ChatService.StreamMessageAsync(_currentSessionId, text, _streamingCts.Token);
            
            bool firstChunk = true;
            await foreach (var chunk in stream)
            {
                if (firstChunk)
                {
                    _isWaitingForResponse = false;
                    firstChunk = false;
                }
                assistantMessage.Text += chunk;
                StateHasChanged();
            }
            if (firstChunk) _isWaitingForResponse = false;
            
            await LoadSessions(); // Refresh list to update message count/preview
        }
        catch (Exception ex)
        {
            assistantMessage.Text += $"\n[Error: {ex.Message}]";
            _isWaitingForResponse = false;
            StateHasChanged();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private void HandleIncomingMessage(string message)
    {
        InvokeAsync(async () =>
        {
            _isWaitingForResponse = false;
            _messages.Add(new ChatMessage { Text = message, IsUser = false });
            await LoadSessions(); // Refresh list to update message count/preview
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        ChatService.OnMessageReceived -= HandleIncomingMessage;
    }

    private class ChatMessage
    {
        public string Text { get; set; } = string.Empty;
        public bool IsUser { get; set; }
    }
}
