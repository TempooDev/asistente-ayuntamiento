@page "/"
@rendermode InteractiveWebAssembly
@inject NavigationManager NavigationManager

<PageTitle>Inicio - Asistente Ayuntamiento</PageTitle>

<div class="min-h-[calc(100vh-4rem)] flex flex-col items-center justify-center p-6 relative overflow-hidden"
     style="background: linear-gradient(135deg, #f0f4f8 0%, #ffffff 50%, #e6f2ed 100%);">
    
    <!-- Decorative background blobs -->
    <div class="absolute top-10 left-10 w-96 h-96 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-pulse" style="background: #93c5fd; animation-duration: 4s;"></div>
    <div class="absolute top-20 right-10 w-96 h-96 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-pulse" style="background: #a7f3d0; animation-duration: 5s;"></div>
    <div class="absolute -bottom-32 left-1/3 w-96 h-96 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-pulse" style="background: #c4b5fd; animation-duration: 6s;"></div>

    <div class="relative z-10 text-center max-w-5xl mx-auto space-y-10 p-10 rounded-3xl shadow-2xl"
         style="background: rgba(255, 255, 255, 0.6); backdrop-filter: blur(16px); border: 1px solid rgba(255,255,255,0.8);">
        
        <div class="space-y-4">
            <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight drop-shadow-sm" style="color: #1a365d;">
                Asistente <span style="background: linear-gradient(to right, #1a365d, #2f855a); -webkit-background-clip: text; color: transparent;">Ayuntamiento</span>
            </h1>
            <p class="text-xl md:text-2xl max-w-2xl mx-auto font-light leading-relaxed" style="color: #4a5568;">
                Tu plataforma inteligente para consultar normativa, ordenanzas y boletines municipales al instante.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 pt-8">
            <a href="/chat" class="group flex flex-col items-center p-8 bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2 border border-gray-100 cursor-pointer text-decoration-none">
                <div class="w-16 h-16 rounded-full flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300 shadow-inner" style="background: #eff6ff; color: #2563eb;">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path></svg>
                </div>
                <h3 class="text-xl font-bold mb-2" style="color: #2d3748;">Iniciar Chat</h3>
                <p class="text-center text-sm" style="color: #718096;">Resuelve tus dudas sobre normativas locales hablando con nuestro asistente IA.</p>
            </a>

            <a href="/documentos" class="group flex flex-col items-center p-8 bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2 border border-gray-100 cursor-pointer text-decoration-none">
                <div class="w-16 h-16 rounded-full flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300 shadow-inner" style="background: #ecfdf5; color: #059669;">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                </div>
                <h3 class="text-xl font-bold mb-2" style="color: #2d3748;">Documentos</h3>
                <p class="text-center text-sm" style="color: #718096;">Explora, sube o revisa el estado de indexación de los boletines oficiales.</p>
            </a>

            <a href="/configuracion-ia" class="group flex flex-col items-center p-8 bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2 border border-gray-100 cursor-pointer text-decoration-none">
                <div class="w-16 h-16 rounded-full flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300 shadow-inner" style="background: #faf5ff; color: #9333ea;">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                </div>
                <h3 class="text-xl font-bold mb-2" style="color: #2d3748;">Ajustes de IA</h3>
                <p class="text-center text-sm" style="color: #718096;">Configura los parámetros del motor de IA, prompts y modelo.</p>
            </a>
        </div>
        
        <div class="mt-12 flex justify-center">
            <a href="/chat" class="px-10 py-4 font-semibold text-lg rounded-full shadow-lg transition-all duration-300 transform hover:-translate-y-1 hover:shadow-xl text-decoration-none"
               style="background: #1a365d; color: white;">
                Comenzar ahora
            </a>
        </div>
    </div>
</div>

