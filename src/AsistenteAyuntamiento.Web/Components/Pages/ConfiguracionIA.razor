@page "/configuracion"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrador")]
@using AsistenteAyuntamiento.Web.Client
@inject AiConfigApiClient AiClient
@inject IJSRuntime JS

<PageTitle>Configuración IA - AdminAI</PageTitle>

<div class="max-w-[800px] mx-auto py-xl">
    <div class="mb-lg">
        <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-background mb-xs">Configuración de IA</h2>
        <p class="font-body-md text-body-md text-on-surface-variant">Gestionar modelos de IA, parámetros de comportamiento e integraciones externas.</p>
    </div>

    @if (isLoading)
    {
        <p>Cargando configuración...</p>
    }
    else
    {
        <EditForm Model="Config" OnValidSubmit="GuardarConfiguracion">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter">
                
                <!-- Model Selection Card -->
                <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-lg shadow-sm">
                    <div class="flex items-center gap-sm mb-md">
                        <span class="material-symbols-outlined text-primary" data-icon="model_training">model_training</span>
                        <h3 class="font-headline-md text-headline-md text-on-surface">Selección de Modelo</h3>
                    </div>
                    <p class="font-body-md text-body-md text-on-surface-variant mb-lg text-sm">Selecciona el modelo base para las consultas.</p>
                    
                    <div class="space-y-sm mb-md">
                        <label class="font-label-md text-label-md text-on-surface">Proveedor</label>
                        <select @bind="Config.Provider" class="w-full border border-outline-variant rounded-lg bg-surface-container-lowest focus:ring-primary focus:border-primary text-sm p-2">
                            <option value="ollama">Ollama (Local)</option>
                            <option value="openai">OpenAI</option>
                        </select>
                    </div>

                    <div class="space-y-sm mb-md">
                        <label class="font-label-md text-label-md text-on-surface">Modelo</label>
                        <input @bind="Config.Model" type="text" class="w-full border border-outline-variant rounded-lg bg-surface-container-lowest focus:ring-primary focus:border-primary text-sm p-2" placeholder="ej. llama3.2 o gpt-4o" />
                    </div>

                    <div class="space-y-sm">
                        <label class="font-label-md text-label-md text-on-surface">API Key</label>
                        <input @bind="Config.ApiKey" type="password" class="w-full border border-outline-variant rounded-lg bg-surface-container-lowest focus:ring-primary focus:border-primary text-sm p-2" placeholder="@(HasSavedApiKey ? "•••••••••••• (Guardada)" : "Introduce API Key (opcional para local)")" />
                        @if (HasSavedApiKey && string.IsNullOrEmpty(Config.ApiKey))
                        {
                            <span class="text-xs text-on-surface-variant">La clave está guardada de forma segura. Ingresa una nueva para sobrescribirla.</span>
                        }
                    </div>
                </div>

                <!-- Parameters Card -->
                <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-lg shadow-sm flex flex-col justify-between">
                    <div>
                        <div class="flex items-center gap-sm mb-md">
                            <span class="material-symbols-outlined text-primary" data-icon="tune">tune</span>
                            <h3 class="font-headline-md text-headline-md text-on-surface">Parámetros</h3>
                        </div>
                        <p class="font-body-md text-body-md text-on-surface-variant mb-lg text-sm">Ajusta el estilo de respuesta para el contexto institucional.</p>
                        
                        <div class="mb-lg">
                            <div class="flex justify-between items-end mb-xs">
                                <label class="font-label-md text-label-md text-on-surface">Creatividad vs Precisión (Temperature)</label>
                                <span class="text-xs font-bold text-primary bg-primary-container px-2 py-1 rounded-full">@Config.Temperature.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)</span>
                            </div>
                            <input type="range" @bind="Config.Temperature" @bind:event="oninput" min="0" max="1" step="0.1" class="w-full h-1 bg-surface-variant rounded-lg appearance-none cursor-pointer" />
                            <div class="flex justify-between text-xs text-on-surface-variant mt-1">
                                <span>Factual</span>
                                <span>Creativo</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Integrations Card (Full Width) -->
                <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-lg shadow-sm md:col-span-2">
                    <div class="flex items-center gap-sm mb-md">
                        <span class="material-symbols-outlined text-primary" data-icon="api">api</span>
                        <h3 class="font-headline-md text-headline-md text-on-surface">Integraciones Institucionales (Knowledge Base)</h3>
                    </div>
                    <p class="font-body-md text-body-md text-on-surface-variant mb-lg text-sm">Gestiona conexiones API a bases de datos internas para recuperación (RAG).</p>
                    
                    <div class="border border-outline-variant rounded-lg divide-y divide-outline-variant">
                        <div class="p-md flex items-center justify-between">
                            <div class="flex items-center gap-md">
                                <div class="w-10 h-10 rounded bg-surface-variant flex items-center justify-center text-on-surface-variant">
                                    <span class="material-symbols-outlined" data-icon="folder_shared">folder_shared</span>
                                </div>
                                <div>
                                    <h4 class="font-label-md text-label-md text-on-surface">Base de Datos de Ciudadanos</h4>
                                    <p class="text-xs text-on-surface-variant">PostgreSQL via Internal Gateway</p>
                                </div>
                            </div>
                            <div class="flex items-center gap-sm">
                                <span class="flex items-center gap-1 text-xs font-bold text-on-tertiary-container bg-tertiary-fixed-dim px-2 py-1 rounded-full">
                                    <span class="w-2 h-2 rounded-full bg-tertiary"></span> Conectado
                                </span>
                                <button type="button" class="p-sm text-secondary hover:text-primary transition-colors"><span class="material-symbols-outlined text-[20px]" data-icon="more_vert">more_vert</span></button>
                            </div>
                        </div>
                        <div class="p-md flex items-center justify-between">
                            <div class="flex items-center gap-md">
                                <div class="w-10 h-10 rounded bg-surface-variant flex items-center justify-center text-on-surface-variant">
                                    <span class="material-symbols-outlined" data-icon="policy">policy</span>
                                </div>
                                <div>
                                    <h4 class="font-label-md text-label-md text-on-surface">API de Jurisprudencia</h4>
                                    <p class="text-xs text-on-surface-variant">External REST Endpoint</p>
                                </div>
                            </div>
                            <div class="flex items-center gap-sm">
                                <span class="flex items-center gap-1 text-xs font-bold text-on-error-container bg-error-container px-2 py-1 rounded-full">
                                    <span class="w-2 h-2 rounded-full bg-error"></span> Error
                                </span>
                                <button type="button" class="font-label-sm text-label-sm text-primary hover:underline px-2">Reconectar</button>
                            </div>
                        </div>
                    </div>
                    <button type="button" class="mt-md text-primary font-label-md text-label-md hover:underline flex items-center gap-xs">
                        <span class="material-symbols-outlined text-[18px]" data-icon="add_link">add_link</span> Añadir Integración
                    </button>
                </div>
            </div>

            @if (showSuccessMessage)
            {
                <div class="mt-4 p-3 bg-tertiary-fixed-dim text-on-tertiary-fixed-variant rounded">
                    Configuración guardada exitosamente.
                </div>
            }
            @if (showErrorMessage)
            {
                <div class="mt-4 p-3 bg-error-container text-on-error-container rounded">
                    Hubo un error al guardar la configuración.
                </div>
            }

            <div class="mt-xl flex justify-end gap-md border-t border-outline-variant pt-lg">
                <button type="button" @onclick="CargarConfiguracion" class="px-lg py-2 border border-primary text-primary font-label-md text-label-md rounded-lg hover:bg-surface-container-low transition-colors min-h-[44px]">Restaurar</button>
                <button type="submit" disabled="@isSaving" class="px-lg py-2 bg-primary text-on-primary font-label-md text-label-md rounded-lg hover:bg-on-primary-fixed-variant transition-colors min-h-[44px]">
                    @(isSaving ? "Guardando..." : "Guardar Configuración")
                </button>
            </div>
        </EditForm>
    }
</div>

@code {
    private SaveAiConfigurationDto Config { get; set; } = new();
    private bool HasSavedApiKey = false;
    private bool isLoading = true;
    private bool isSaving = false;
    private bool showSuccessMessage = false;
    private bool showErrorMessage = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarConfiguracion();
    }

    private async Task CargarConfiguracion()
    {
        isLoading = true;
        showSuccessMessage = false;
        showErrorMessage = false;
        
        try
        {
            var currentConfig = await AiClient.GetConfigurationAsync();
            Config = new SaveAiConfigurationDto
            {
                Provider = currentConfig.Provider,
                Model = currentConfig.Model,
                Temperature = currentConfig.Temperature,
                ApiKey = null // Never show the real API key on the frontend
            };
            HasSavedApiKey = currentConfig.HasApiKey;
        }
        catch
        {
            showErrorMessage = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task GuardarConfiguracion()
    {
        isSaving = true;
        showSuccessMessage = false;
        showErrorMessage = false;

        try
        {
            await AiClient.SaveConfigurationAsync(Config);
            showSuccessMessage = true;
            
            if (!string.IsNullOrEmpty(Config.ApiKey))
            {
                HasSavedApiKey = true;
                Config.ApiKey = null; // Clear from input
            }
            
            // Ocultar mensaje de éxito después de un tiempo
            _ = Task.Delay(3000).ContinueWith(async _ =>
            {
                showSuccessMessage = false;
                await InvokeAsync(StateHasChanged);
            });
        }
        catch
        {
            showErrorMessage = true;
        }
        finally
        {
            isSaving = false;
        }
    }
}
